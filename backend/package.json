{
  "name": "campusbridge-backend",
  "version": "1.0.0",
  "description": "Backend API for CampusBridge Campus Events & Micro-Sponsorship Platform",
  "main": "dist/index.js",
  "scripts": {
    "test": "tsx --test test/crud.test.ts",
    "dev": "tsx watch src/index.ts",
